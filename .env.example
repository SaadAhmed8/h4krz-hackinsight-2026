# OpenAQ API v3 Configuration
# Get your API key by registering at https://explore.openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here

# RAG Answer Agent configuration
# Providers: gemini (default), openai, anthropic, openai_compatible
RAG_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
RAG_LLM_MODEL=gemini-3.8-flash
RAG_LLM_TIMEOUT=300
RAG_LLM_MAX_TOKENS=700
RAG_LLM_TEMPERATURE=0
# Optional provider fallbacks:
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
