# RAG Answer Agent configuration.
# Providers: openai, openai_compatible, anthropic, gemini
RAG_LLM_PROVIDER=gemini

# Either set RAG_LLM_API_KEY, or use the provider-specific fallback below.
RAG_LLM_API_KEY=

# Defaults: gpt-4o-mini (openai), claude-3-5-haiku-latest (anthropic),
# gemini-3.8-flash (gemini). Required for openai_compatible.
RAG_LLM_MODEL=gemini-3.8-flash

# Required for openai_compatible. Ignored by gemini/openai/anthropic.
RAG_LLM_BASE_URL=

# Gemini can take longer than legacy providers; keep a generous timeout.
RAG_LLM_TIMEOUT=300
RAG_LLM_MAX_TOKENS=700
RAG_LLM_TEMPERATURE=0

# Provider-specific fallbacks used when RAG_LLM_API_KEY is empty.
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
